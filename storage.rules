rules_version = '2'; service firebase.storage { match /b/{bucket}/o { function signedIn(){return request.auth != null;} match /users/{uid}/reports/{reportId}/{fileName}{allow read: if signedIn()&&request.auth.uid==uid;allow write: if signedIn()&&request.auth.uid==uid&&request.resource.size<10*1024*1024&&request.resource.contentType.matches('application/(pdf)|image/(jpeg|png)');} match /users/{uid}/meals/{fileName}{allow read,write: if signedIn()&&request.auth.uid==uid&&request.resource.size<8*1024*1024&&request.resource.contentType.matches('image/(jpeg|png|webp)');}}}
