# Public Expo Firebase web config (safe to expose; secure access is enforced by rules)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Cloud Functions region and optional emulator host
EXPO_PUBLIC_FUNCTIONS_REGION=asia-south1
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
# Server-only: set with `firebase functions:secrets:set GEMINI_API_KEY`; never put in Expo env.
GEMINI_API_KEY=
